# 3D pipeline
#
# Every rule below sits on its own line, and the comments do too. `#` only opens
# a comment at the START of a line: written as `assets/source/**  # source FBX`,
# the comment becomes part of the pattern and the rule silently matches nothing.
# That is how it was written until 2026-09-02, so this whole block was inert —
# `git check-ignore` reported NOT IGNORED for a 39 MB .blend and 40 MB of raw glb
# sitting untracked in the tree.

# Source FBX / BLEND / OBJ — hundreds of MB, and they live in the library.
assets/source/**
!assets/source/.gitkeep

# Blender's uncompressed intermediate, regenerated by `npm run convert`.
assets/models/*.raw.glb

# STEP CAD source. 11.7 MB for one robot; the glb is the deliverable.
*.stp
*.step
*.STP
*.STEP

# The flat survey export — an instrument, not an asset. Regenerated by
# `node tools/step-to-glb.mjs <file.stp>` with no --rig.
assets/**/*-survey.glb

# Copied out of three on postinstall.
public/decoders/

# Unresolved provenance — recorded in assets/ASSETS.md as do-not-ship. It is a
# declared derivative of a current commercial product, so it stays out of the
# history until that is settled. Committing it is the one action that cannot be
# undone quietly.
assets/models/midnight-division*

# Verification captures. Browser screenshots taken while checking the render are
# working notes, not deliverables — three of them were committed by a careless
# `git add -A` in ff43f10 and removed in the commit after it.
/*.png
.playwright-mcp/
.shots/

# the local hub is generated — versions/ is an output, not a source
versions/

# playwright browsers live in the machine cache, not here
tools/.shoot-run.mjs
