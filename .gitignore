# Dependencies, caches and build output — at any depth.
**/node_modules/
**/.cache/
**/.vite/
**/dist/
**/build/
**/coverage/

# Environment and secrets.
**/.env
**/.env.*
!**/.env.example

# Logs and OS noise.
*.log
.DS_Store
Thumbs.db

# Local editor / agent state. The shared settings.json IS tracked; only the
# machine-local override is not.
**/.claude/settings.local.json

# Playwright runtime and session directories. These are driver state, written on
# every browser run — never project source.
**/.playwright/
**/.playwright-cli/
**/.playwright-mcp/

# ---------------------------------------------------------------------------
# _buro test 1 — regenerated artefacts, not sources.
#
# Scoped to this project on purpose. `_buro test 2` keeps its own
# assets/source/ because the pipeline reads from it and the generated frames in
# it are NOT reproducible: the model is non-deterministic, so a re-run produces a
# different image even from the recorded prompt.
# ---------------------------------------------------------------------------
/_buro test 1/assets/source/
/_buro test 1/assets/models/*.raw.glb
/_buro test 1/public/decoders/
